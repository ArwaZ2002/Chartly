# Backend Configuration
# Copy this file to .env and adjust as needed.
# This file must only ever contain placeholders — never real secrets.

APP_NAME=Chartly
APP_VERSION=2.0.0

# development | production
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=sqlite:///./chartly.db

# Generate a strong random key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The server will not be secure with the placeholder value.
SECRET_KEY=change-me
# Optional alias for SECRET_KEY (takes precedence when set).
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Comma-separated list of allowed browser origins (no wildcard with cookies).
# Include the origin(s) the SPA is served from in production.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# API docs (/docs, /redoc, /openapi.json).
# Leave empty for auto: enabled in development, disabled in production.
# Set explicitly to true/false to override.
ENABLE_API_DOCS=

# Auth cookie. Set COOKIE_SECURE=true when serving over HTTPS
# (this also enables the HSTS header).
COOKIE_NAME=chartly_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set true only when the app runs behind a trusted reverse proxy
# (client IP is then read from X-Forwarded-For).
TRUST_PROXY=false

# Login brute-force protection (failed attempts per window)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_IP=20
LOGIN_RATE_WINDOW_SECONDS=60

MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".csv",".xlsx",".xls"]

# Postgres example (Neon): postgresql://user:pass@host/dbname
# Uploaded files are stored as bytes in the database, so no disk is required.